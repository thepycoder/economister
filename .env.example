# Copy to .env in the project root and fill in your Economist credentials.
# .env is gitignored — never commit real credentials.

ECONOMIST_EMAIL=your-email@example.com
ECONOMIST_PASSWORD=your-password

# Run Chrome headlessly for login (default). Set to false for a visible window
# (needed if you rely on manual CAPTCHA/2FA login).
HEADLESS=true

# Set automatically in Docker. Prevents hanging on manual login.
# ECONOMISTER_NONINTERACTIVE=true

# Belgium pipeline (Anthropic API)
# ANTHROPIC_API_KEY=sk-ant-...
# BELGIUM_MODEL=claude-opus-5-5
# Optional override for the writer stage only:
# BELGIUM_WRITER_MODEL=claude-opus-5-5
# Thinking effort (low|medium|high|xhigh|max):
# BELGIUM_EFFORT=high
# Append that week's Belgium briefing as an EPUB section (default true).
# BELGIUM_SECTION=true
